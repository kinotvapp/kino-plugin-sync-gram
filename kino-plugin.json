{
  "id": "sync-gram",
  "name": "Sync-Gram",
  "version": "1.1.0",
  "apiVersion": 14,
  "entry": "plugin.js",
  "description": "Sincroniza tus aparatos de Kino a través de un bot de Telegram que creas tú; la copia queda fijada en tu chat con el bot. No oficial: sin relación con Telegram. (Unofficial: not affiliated with Telegram.)",
  "author": "Kino",
  "homepage": "https://github.com/kinotvapp/kino-plugin-sync-gram",
  "icon": "icon.png",
  "hosts": [
    "api.telegram.org"
  ],
  "capabilities": [
    "syncProvider",
    "screen"
  ],
  "settings": [
    {
      "key": "botToken",
      "label": "Token del bot",
      "labelEn": "Bot token",
      "type": "password",
      "devices": [
        "phone"
      ]
    },
    {
      "key": "chatId",
      "label": "Id del chat",
      "labelEn": "Chat id",
      "type": "text",
      "hint": "Se llena solo al confirmar tu chat; cámbialo solo si sabes cuál es",
      "hintEn": "Filled in when you confirm your chat; change it only if you know it",
      "devices": [
        "phone"
      ]
    }
  ],
  "sync": {
    "mode": "poll",
    "pullEveryMs": 600000,
    "pushDebounceMs": 300000,
    "maxBlobBytes": 4194304,
    "keySecret": "botToken",
    "provision": [
      "botToken",
      "chatId"
    ]
  },
  "screen": {
    "label": "Sync-Gram",
    "labelEn": "Sync-Gram",
    "opensFrom": [
      "settings"
    ],
    "settingsIn": "screen",
    "settingsButton": {
      "label": "Configurar",
      "labelEn": "Set up"
    }
  },
  "signature": {
    "authorKey": "82b87b938e0a95b142467c815a8823cb54310a13a828c3c4c77b1eda43294ae6",
    "value": "a5760a7b3f4cfc1df408fa1e496d3e20a0b40dbb92690501a953c3a794a9d3eb13c0ba72dfcf77092aa51e97ca78cf45750007b1fcc62f3b5661ffe217ec1605"
  }
}
